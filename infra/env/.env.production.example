# Root-owned /root/deploy/.env, mode 0600. These are shell assignments.
# No passwords, Firebase private keys or S3 keys belong here.
DOMAIN=your-domain.example
EMAIL=your-acme-contact@example.com
BACKEND_PORT=5000
DB_PORT=5432
DB_NAME=eventsdb
DB_USER=user
REDIS_PORT=6379
FIREBASE_PROJECT_ID=your-firebase-project

# AWS S3: leave endpoint empty so rclone selects the regional AWS endpoint.
S3_PROVIDER=AWS
S3_REGION=ca-central-1
S3_BUCKET=your-private-backup-bucket
S3_ENDPOINT=
S3_PREFIX=backups

# Optional zero-replica notification worker; requires dedicated SES Docker secrets.
# Keep all delivery gates false until verified-recipient and signed feedback tests pass.
NOTIFICATIONS_CONFIGURED=false
EMAIL_PROVIDER=disabled
EMAIL_DELIVERY_ENABLED=false
EMAIL_FEEDBACK_READY=false
MARKETING_DELIVERY_ENABLED=false
EMAIL_FROM=
SES_REGION=ca-central-1
SES_CONFIGURATION_SET=
SES_FEEDBACK_TOPIC_ARN=
SES_AUTO_CONFIRM_SUBSCRIPTION=false

# DigitalOcean alternative:
# S3_PROVIDER=DigitalOcean
# S3_REGION=tor1
# S3_ENDPOINT=https://tor1.digitaloceanspaces.com
# S3_BUCKET=your-private-space

# Image values are supplied by deploy.sh. Keep the last successful release in
# /root/deploy/.release.env; use its exact tag for manual rollback.
