# Docker ignore for root-level builds

# Ignore all node_modules
**/node_modules/

# Ignore build outputs
**/dist/
**/build/

# Ignore environment files
**/.env
**/.env.local
**/.env.development
**/.env.test
**/.env.production
**/.env.*
**/secrets/
**/.local/
**/firebase-service-account*.json
**/*-firebase-adminsdk-*.json
**/service-account*.json
**/credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/*_password*.txt
**/.s3cfg
**/acme.json
**/backups/
**/*.dump
**/*.backup
**/*.sql.gz
**/*.tfstate*
**/.terraform/
**/*.tfvars

# Ignore git
.git/
.gitignore

# Ignore editor files
**/.vscode/
**/*.swp
**/*.swo
**/*~

# Ignore OS files
**/.DS_Store
**/Thumbs.db

# Ignore logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Ignore coverage
**/coverage/

# Ignore temporary files
**/.tmp/
**/tmp/

# For API builds, ignore client files
api/client/
client/node_modules/
client/dist/

# For client builds, ignore API files when building from root
client/api/
